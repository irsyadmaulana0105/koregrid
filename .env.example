APP_NAME=KoreGrid
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
APP_PORT=8081

# Wajib diisi sebelum `docker compose up` (compose menolak nilai kosong)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=koregrid
DB_USERNAME=koregrid
# Wajib diisi (docker compose menolak start jika kosong). Contoh: openssl rand -hex 16
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# Wajib diisi (docker compose menolak start jika kosong).
REDIS_PASSWORD=

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

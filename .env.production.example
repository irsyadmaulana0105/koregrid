# Template environment production. Isi nilai asli lewat secret manager atau file .env.production
# (diabaikan Git). JANGAN commit nilai asli. Image production tidak membawa file .env.
APP_NAME=KoreGrid
APP_ENV=production
# Buat dengan: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://GANTI-DENGAN-DOMAIN

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=koregrid
DB_USERNAME=koregrid
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Cookie sesi hanya dikirim lewat HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# IP atau CIDR proxy/load balancer yang sebenarnya, dipisah koma. Kosong = tidak ada proxy dipercaya.
# Jangan isi "*": nilai itu ditolak saat boot karena membuat IP klien bisa dipalsukan.
TRUSTED_PROXIES=

KOREGRID_TAX_RATE=0.11
KOREGRID_DRAFT_TTL_HOURS=24
